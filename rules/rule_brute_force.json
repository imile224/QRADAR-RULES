{
  "name": "Custom: Multiple Failed Logins Detected",
  "description": "Detects 5 or more failed login attempts for the same username within 5 minutes.",
  "type": "MAPPING",
  "enabled": true,
  "capacity_timestamp": 0,
  "responses": {
    "dispatch_new_event": true,
    "event_description": "Multiple Failed Logins Brute Force Attempt",
    "event_name": "Brute Force Detected"
  },
  "tests": [
    {
      "uid": "1",
      "type": "AndTest",
      "text": "when the event matches Multiple Failed Logins",
      "tests": [
        {
          "type": "EventPropertyTest",
          "property": "Category",
          "operator": "EQUALS",
          "value": "Authentication"
        },
        {
          "type": "EventPropertyTest",
          "property": "Event Result",
          "operator": "EQUALS",
          "value": "Failure"
        }
      ]
    }
  ],
  "rule_action": {
    "create_offense": true,
    "offense_type": "Source IP"
  }
}
