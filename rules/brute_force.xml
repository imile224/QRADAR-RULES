<custom_rule>
    <name>TEST - Multiple Failed Logins</name>
    <description>Detects multiple failed login attempts from same source</description>
    <enabled>true</enabled>

    <rule_type>EVENT</rule_type>

    <conditions>
        <condition>
            <field>Event Name</field>
            <operator>equals</operator>
            <value>Login Failed</value>
        </condition>
    </conditions>

    <tests>
        <test>
            <type>threshold</type>
            <field>Source IP</field>
            <count>5</count>
            <timeframe>60</timeframe>
        </test>
    </tests>

    <responses>
        <create_offense>true</create_offense>
        <severity>5</severity>
    </responses>
</custom_rule>
