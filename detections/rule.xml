<?xml version="1.0" encoding="UTF-8"?>
<content_export>
    <custom_rule>
        <name>GitHub: New User Created (ID 4720)</name>
        <description>Detects when a new user is created based on EventID 4720</description>
        <enabled>true</enabled>
        <base_capacity>0</base_capacity>
        <rule_type>EVENT</rule_type>
        <responses>
            <create_offense>true</create_offense>
            <offense_naming_type>RULE_NAME</offense_naming_type>
        </responses>
        <tests>
            <test_definition>
                <type>PROPERTY_IS_EQUAL</type>
                <negate>false</negate>
                <property_name>EventID</property_name>
                <property_value>4720</property_value>
            </test_definition>
        </tests>
    </custom_rule>
</content_export>
