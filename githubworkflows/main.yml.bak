name: QRadar Rule Deployment

on:
  push:
    branches:
      - main
    paths:
      - 'qradar_rules/**'

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v3

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.9'

      - name: Install Dependencies
        run: pip install requests pyyaml

      - name: Run Deployment Script
        env:
          QRADAR_IP: ${{ secrets.QRADAR_IP }}
          QRADAR_API_KEY: ${{ secrets.QRADAR_API_KEY }}
        run: python scripts/qradar_deploy.py
